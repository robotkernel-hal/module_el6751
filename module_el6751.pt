PTVERSION           = 2
NAME                = module_el6751
VERSION             = 3.0.0
DESCRIPTION         = robotkernel module for beckhoff el6751
MAINTAINER          = Robert Burger <robert.burger@dlr.de>
DOCUMENTATION       = https://rmintra01/rmwiki/index.php/Sercos_Master_RTOS
C++_INCLUDE_PATHS   = ${PKGROOT}/include/
C++_LIB_PATHS       = ${PKGROOT}/lib/${ARCH}
C++_LIBS            = module_el6751
ARCHS               = sled11-x86-gcc4.x, sled11-x86_64-gcc4.x, vxworks6.7-x86-gcc4.x, vxworks6.8-x86-gcc4.x, vxworks6.9-x86-gcc4.x, vxworks6.9.3-x86-gcc4.x, vxworks6.9.4-x86-gcc4.x
TYPE                =
SUPPORTED_LANGUAGES = C++

[install]
build/sled11-x86-gcc4.x/install/include/ => include/
build/${ARCH}/install/lib => lib/${ARCH}

