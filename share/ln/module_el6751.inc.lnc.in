requires_version 0.2.43
# this include file can be customized with the following defines:
#   module_el6751_base
#     (optional) path to module_el6751 base directory
#     e.g. /volume/software/robotkernel/packages/module_el6751/3.0.1
#     defaults to rmpm structure
#   module_el6751_libdir
#     (optional) add custom module search paths
#   module_el6751_mds
#     (optional) add custom message definition paths

defines
module_el6751_base: %(dirname %(dirname %(CURDIR)))
module_el6751_libdir:        %(subst "${exec_prefix}/", "", "@libdir@")
module_el6751_type:          %(ifexists "%(module_el6751_base)/%(module_el6751_libdir)/libmodule_el6751.so", "local_install", "rmpm_release")
module_el6751_library_path:  %(ifeq "%(module_el6751_type)", "local_install", "%(module_el6751_base)/%(module_el6751_libdir)", "%(module_el6751_base)/lib/$(ARCH)")

ifndef rk_library_path: rk_library_path: ""
rk_library_path: %(rk_library_path):%(module_el6751_libdir)

